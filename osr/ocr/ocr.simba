{$DEFINE SRL_OCR_INCLUDED}
{$IFNDEF SRL_OSR}
  {$I SRL-T/osr.simba}
{$ENDIF}

{$loadlib ../../plugins/libsimpleocr/libsimpleocr}

const
  RS_FONT_PATH = {$macro CURRENT_DIRECTORY} + 'fonts' + DirectorySeparator;

var
  RS_FONT_PLAIN_11: TFontSet;
  RS_FONT_PLAIN_12: TFontSet;
  RS_FONT_BOLD_12: TFontSet;
  RS_FONT_BOLD_12_SHADOW: TFontSet;
  RS_FONT_QUILL_8: TFontSet;
  RS_FONT_QUILL: TFontSet;

  OCR: TSimpleOCR;

(*
## TRSOCRMatcher
Tolerant text matching for OCR output (uptext, choose option menus, ...).

Set `OCRMatch.Fuzzy := False` to restore strict matching everywhere.
*)
type
  TRSOCRMatcher = record
    Fuzzy: Boolean;
    MinLength: Int32;
    LongLength: Int32;
    DebugRescues: Boolean;
    Rescues: Int32;
  end;

var
  OCRMatch: TRSOCRMatcher;

function TRSOCRMatcher.Normalize(s: String): String;
var
  i: Int32;
  c: Char;
begin
  Result := '';
  s := LowerCase(s);
  for i := 1 to Length(s) do
  begin
    c := s[i];
    if ((c >= 'a') and (c <= 'z')) or ((c >= '0') and (c <= '9')) then
      Result += c;
  end;
end;

function TRSOCRMatcher._SubCost(a, b: Char): Int32;
var
  groups: TStringArray;
  i: Int32;
begin
  if a = b then Exit(0);
  groups := ['il1j', 'o0', 'ec', 's5', 'z2', 'b8', 'g9', 'uv'];
  for i := 0 to High(groups) do
    if (Pos(a, groups[i]) > 0) and (Pos(b, groups[i]) > 0) then
      Exit(1);
  Result := 2;
end;

function TRSOCRMatcher.Distance(hay, needle: String): Int32;
var
  m, n, i, j, cost: Int32;
  prev, cur: TIntegerArray;
begin
  m := Length(needle);
  n := Length(hay);
  if m = 0 then Exit(0);
  if n = 0 then Exit(m);

  SetLength(prev, n + 1);
  SetLength(cur, n + 1);
  for j := 0 to n do prev[j] := 0;

  for i := 1 to m do
  begin
    cur[0] := i;
    for j := 1 to n do
    begin
      cost := prev[j - 1] + Self._SubCost(needle[i], hay[j]);
      if prev[j] + 1 < cost then cost := prev[j] + 1;
      if cur[j - 1] + 1 < cost then cost := cur[j - 1] + 1;
      cur[j] := cost;
    end;
    prev := Copy(cur);
  end;

  Result := prev[0];
  for j := 1 to n do
    if prev[j] < Result then Result := prev[j];
end;

function TRSOCRMatcher.Strict(hay, needle: String): Boolean;
begin
  Result := (needle in hay) or (needle = hay);
end;

function TRSOCRMatcher.Matches(hay, needle: String): Boolean;
var
  h, n: String;
  allowed: Int32;
begin
  if Self.Strict(hay, needle) then Exit(True);
  if not Self.Fuzzy then Exit(False);

  n := Self.Normalize(needle);
  if n = '' then Exit(False);
  h := Self.Normalize(hay);
  if h = '' then Exit(False);

  Result := n in h;
  if not Result and (Length(n) >= Self.MinLength) then
  begin
    allowed := 1;
    if Length(n) >= Self.LongLength then allowed := 2;
    Result := Self.Distance(h, n) <= allowed;
  end;

  if Result then
  begin
    Inc(Self.Rescues);
    if Self.DebugRescues then
      WriteLn(SRL.TimeStamp() + ':[OCRMatch]: fuzzy match "' + needle + '" in "' + hay + '"');
  end;
end;

function TRSOCRMatcher.MatchesAny(hay: String; needles: TStringArray; out index: Int32): Boolean; overload;
begin
  for index := 0 to High(needles) do
    if Self.Strict(hay, needles[index]) then
      Exit(True);

  if Self.Fuzzy then
    for index := 0 to High(needles) do
      if Self.Matches(hay, needles[index]) then
        Exit(True);

  index := -1;
end;

function TRSOCRMatcher.MatchesAny(hay: String; needles: TStringArray): Boolean; overload;
var
  i: Int32;
begin
  Result := Self.MatchesAny(hay, needles, i);
end;

begin
  OCRMatch.Fuzzy := True;
  OCRMatch.MinLength := 5;
  OCRMatch.LongLength := 12;
  {$IFDEF SRL_DEBUG_UPTEXT}
  OCRMatch.DebugRescues := True;
  {$ENDIF}
end;

begin
  RS_FONT_PLAIN_11.Load(RS_FONT_PATH + 'Plain 11');
  RS_FONT_PLAIN_12.Load(RS_FONT_PATH + 'Plain 12');
  RS_FONT_BOLD_12.Load(RS_FONT_PATH + 'Bold 12');
  RS_FONT_BOLD_12_SHADOW.Load(RS_FONT_PATH + 'Bold 12 Shadow');
  RS_FONT_QUILL_8.Load(RS_FONT_PATH + 'Quill 8');
  RS_FONT_QUILL.Load(RS_FONT_PATH + 'Quill');
end;
